# Storage: SQLite now; replace with postgresql+psycopg://user:pass@host/db later.
DATABASE_URL=sqlite:///./data/afran.db
DATABASE_AUTO_CREATE=false
ENVIRONMENT=production

# Scheduler interval in seconds. Keep one Gunicorn worker when enabled.
CRAWL_INTERVAL=86400
SCHEDULER_ENABLED=true
CRAWL_ON_STARTUP=false

FIPIRAN_URL=https://www.fipiran.com
FIPIRAN_FUND_LIST_PAGE=/mf/list
FIPIRAN_SERVICES_PATH=/services
FIPIRAN_FUND_COMPARE_PATH=/fund/fundcompare/
FIPIRAN_FUND_DETAIL_PATH=/fund/getfund
FIPIRAN_FUND_TYPES_PATH=/fund/fundtype
FIPIRAN_NAV_HISTORY_PATH=/chart/getfundchart
FIPIRAN_NET_ASSET_HISTORY_PATH=/chart/getfundnetassetchart
FIPIRAN_PORTFOLIO_HISTORY_PATH=/chart/portfoliochart

HTTP_TIMEOUT=30
HTTP_RETRIES=3
RETRY_BASE_DELAY=1
CRAWL_MAX_RPS=2
CRAWL_DETAIL_CONCURRENCY=4
CRAWL_MAX_FUNDS=0
CRAWL_FETCH_HISTORY=true
CRAWL_FETCH_PORTFOLIO_HISTORY=true
FIPIRAN_SHOW_ALL_HISTORY=false
PLAYWRIGHT_ENABLED=true
BROWSER_TIMEOUT_MS=45000
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=180
GUNICORN_GRACEFUL_TIMEOUT=30

# Percent-point benchmark used by allocation ranking responses.
ALLOCATION_BENCHMARK_BM=2.99

# Optional protection for POST /crawl. Leave blank only on a private network.
CRAWL_API_KEY=
